# ---------------------------------------------------------------------------
# Media Studio backend configuration
# Copy to .env and fill in what you need.
# ---------------------------------------------------------------------------

# Where uploaded + generated media is stored on disk.
STORAGE_DIR=./data

# Public base URL of this API. Used to build absolute media URLs that the
# Android app can load directly. Set this to your deployed https URL.
PUBLIC_BASE_URL=http://10.0.2.2:8000

# Comma separated list of allowed CORS origins ("*" for dev only).
CORS_ORIGINS=*

# Max upload size in megabytes.
MAX_UPLOAD_MB=200

# ---------------------------------------------------------------------------
# AI provider selection: mock | fal | gemini | replicate
# "mock" runs entirely offline and returns placeholder results, so the whole
# pipeline (upload -> job -> result) can be tested without spending money.
# ---------------------------------------------------------------------------
AI_PROVIDER=mock

# --- fal.ai (recommended: best model coverage for image AND video) ---------
FAL_KEY=
# Prompt-based image editing (instruction editing, keeps identity/composition)
IMAGE_EDIT_MODEL=fal-ai/flux-pro/kontext
# Text-to-image
IMAGE_GEN_MODEL=fal-ai/flux/schnell
# Image upscaling
UPSCALE_MODEL=fal-ai/clarity-upscaler
# Background removal
BG_REMOVAL_MODEL=fal-ai/imageutils/rembg
# Text-to-video
VIDEO_GEN_MODEL=fal-ai/kling-video/v1.6/standard/text-to-video
# Video restyle / video-to-video
VIDEO_EDIT_MODEL=fal-ai/kling-video/v1.6/standard/video-to-video

# --- Google Gemini (image editing only; generous free tier) ----------------
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Replicate (fallback; any model on replicate.com) ----------------------
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_EDIT_MODEL=black-forest-labs/flux-kontext-pro
